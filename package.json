{
  "name": "faultmcp",
  "version": "0.1.0",
  "description": "An MCP server that injects tool faults on purpose, so you can test how your agent copes when a tool errors, stalls, truncates, or quietly returns the wrong answer.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "fault-injection",
    "chaos-engineering",
    "llm",
    "agents",
    "testing",
    "reliability"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dimhold/faultmcp.git"
  },
  "homepage": "https://github.com/dimhold/faultmcp#readme",
  "bugs": {
    "url": "https://github.com/dimhold/faultmcp/issues"
  },
  "author": "Dmitriy Semenkevich <dimhold@gmail.com>",
  "type": "module",
  "bin": {
    "faultmcp": "dist/bin.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "profiles",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "start": "node dist/bin.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "smoke": "node .github/scripts/smoke.mjs",
    "check:package": "node .github/scripts/check-package.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "yaml": "^2.9.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
