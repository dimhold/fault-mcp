{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",

    // No maps anywhere, not just in the tarball. They point at a src directory
    // the package does not contain, so every one of them is a dead link for
    // whoever installed it: 30 shipped in the first pack of this repository
    // before anyone looked inside. Off in the base config too, so the
    // repository build cannot quietly start emitting them again.
    "sourceMap": false,
    "declarationMap": false
  },
  "include": ["src/**/*.ts"]
}
